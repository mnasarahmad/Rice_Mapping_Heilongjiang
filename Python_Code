def create_evidence_outputs(evidence_tifs):
    if not evidence_tifs:
        log(
            "No evidence TIFFs found. "
            "Evidence figures were skipped."
        )
        return

    mosaic_evidence = str(
        GDB_PATH /
        "HLJ_Rice_2025_Evidence_Mosaic"
    )

    if arcpy.Exists(mosaic_evidence):
        arcpy.management.Delete(
            mosaic_evidence
        )

    first = arcpy.Raster(
        str(evidence_tifs[0])
    )

    arcpy.management.MosaicToNewRaster(
        input_rasters=";".join(
            str(path) for path in evidence_tifs
        ),
        output_location=str(GDB_PATH),
        raster_dataset_name_with_extension=(
            "HLJ_Rice_2025_Evidence_Mosaic"
        ),
        coordinate_system_for_the_raster=(
            first.spatialReference
        ),
        pixel_type="8_BIT_UNSIGNED",
        cellsize=first.meanCellWidth,
        number_of_bands=9,
        mosaic_method="MAXIMUM",
        mosaic_colormap_mode="FIRST"
    )

    evidence_tif = (
        OUT_DIR /
        "HLJ_Rice_2025_Evidence_Mosaic_9Bands.tif"
    )

    arcpy.management.CopyRaster(
        in_raster=mosaic_evidence,
        out_rasterdataset=str(evidence_tif),
        pixel_type="8_BIT_UNSIGNED",
        nodata_value="0",
        format="TIFF"
    )

    log(f"Evidence mosaic saved: {evidence_tif}")

    raster = arcpy.Raster(str(evidence_tif))
    arr = arcpy.RasterToNumPyArray(
        raster,
        nodata_to_value=0
    )

    if arr.ndim != 3 or arr.shape[0] < 9:
        log(
            "Evidence raster does not contain "
            "the expected 9 bands. "
            "Evidence figures were skipped."
        )
        return

    ex = raster.extent
    extent = [
        ex.XMin,
        ex.XMax,
        ex.YMin,
        ex.YMax
    ]

    final_rice = arr[0]
    flood_water = arr[3]
    sar_flood = arr[4]
    green_canopy = arr[5]
    possible_missed = arr[7]
    possible_false = arr[8]

    def binary_mask(a):
        return np.where(
            a > 0,
            1,
            np.nan
        )

    # Evidence panel
    fig, axes = plt.subplots(
        2, 2,
        figsize=(12, 10),
        dpi=300
    )

    panel = [
        (
            flood_water,
            "A. Flood-water evidence",
            "Blues"
        ),
        (
            sar_flood,
            "B. SAR-flood evidence",
            "Purples"
        ),
        (
            green_canopy,
            "C. Green-canopy evidence",
            "Greens"
        ),
        (
            final_rice,
            "D. Final rice map",
            "Greens"
        )
    ]

    for axis, (
        layer,
        title,
        cmap
    ) in zip(axes.ravel(), panel):

        axis.imshow(
            binary_mask(layer),
            extent=extent,
            origin="upper",
            cmap=cmap,
            interpolation="nearest"
        )

        axis.set_title(
            title,
            fontsize=12,
            fontweight="bold"
        )

        axis.set_xlabel(
            "Longitude / Easting",
            fontsize=9
        )

        axis.set_ylabel(
            "Latitude / Northing",
            fontsize=9
        )

        axis.grid(
            linewidth=0.3,
            alpha=0.3
        )

    fig.suptitle(
        "Phenological and SAR–Optical "
        "Evidence for Rice Mapping",
        fontsize=16,
        fontweight="bold",
        y=0.98
    )

    plt.tight_layout()

    panel_png = (
        OUT_DIR /
        "Figure_3_Phenological_Evidence_Panel.png"
    )

    panel_pdf = (
        OUT_DIR /
        "Figure_3_Phenological_Evidence_Panel.pdf"
    )

    fig.savefig(
        panel_png,
        dpi=600,
        bbox_inches="tight"
    )

    fig.savefig(
        panel_pdf,
        bbox_inches="tight"
    )

    plt.close(fig)

    # Diagnostic uncertainty map
    rgb = np.ones(
        (
            final_rice.shape[0],
            final_rice.shape[1],
            3
        ),
        dtype=np.float32
    )

    rgb[final_rice > 0] = [
        0.0,
        0.45,
        0.0
    ]

    rgb[possible_missed > 0] = [
        1.0,
        0.55,
        0.0
    ]

    rgb[possible_false > 0] = [
        0.90,
        0.0,
        0.0
    ]

    fig, ax = plt.subplots(
        figsize=(10, 8),
        dpi=300
    )

    ax.imshow(
        rgb,
        extent=extent,
        origin="upper",
        interpolation="nearest"
    )

    ax.set_title(
        "Diagnostic Rice-Mapping "
        "Uncertainty Map",
        fontsize=16,
        fontweight="bold",
        pad=12
    )

    ax.set_xlabel(
        "Longitude / Easting",
        fontsize=12
    )

    ax.set_ylabel(
        "Latitude / Northing",
        fontsize=12
    )

    ax.grid(
        linewidth=0.35,
        alpha=0.35
    )

