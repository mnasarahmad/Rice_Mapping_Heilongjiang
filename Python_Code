# ============================================================
# 1. USER SETTINGS
# ============================================================

WORK_DIR = Path(r"C:\Users\Zohan\Downloads\Zohan202A")
OUT_DIR = WORK_DIR / "HLJ_Rice_2025_Publication_Outputs"
OUT_DIR.mkdir(parents=True, exist_ok=True)

GDB_PATH = OUT_DIR / "HLJ_Rice_2025_Workspace.gdb"

# Maximum display image dimension for the interactive HTML map.
MAX_DISPLAY_SIZE = 2200

# Main naming pattern used for final-rice prefecture exports.
FINAL_FILE_PATTERN = re.compile(
    r"HLJ_Rice_2025_.*_30m\.tif$",
    flags=re.IGNORECASE
)

# Evidence rasters, if exported.
EVIDENCE_FILE_PATTERN = re.compile(
    r"HLJ_Rice_2025_.*Evidence.*\.tif$",
    flags=re.IGNORECASE
)


# ============================================================
# 2. BASIC SETUP
# ============================================================

def log(message):
    print(message, flush=True)


def ensure_workspace():
    if not WORK_DIR.exists():
        raise FileNotFoundError(
            f"Working folder does not exist:\n{WORK_DIR}"
        )

    if not arcpy.Exists(str(GDB_PATH)):
        arcpy.management.CreateFileGDB(
            str(OUT_DIR),
            GDB_PATH.name
        )

    arcpy.env.overwriteOutput = True

    log(f"Working folder: {WORK_DIR}")
    log(f"Output folder: {OUT_DIR}")
    log(f"Geodatabase: {GDB_PATH}")


# ============================================================
# 3. FILE DISCOVERY
# ============================================================

def discover_files():
    all_tifs = sorted(WORK_DIR.rglob("*.tif"))

    final_prefecture_tifs = []
    province_final_candidates = []
    evidence_tifs = []

    for path in all_tifs:
        name = path.name

        if EVIDENCE_FILE_PATTERN.search(name):
            evidence_tifs.append(path)
            continue

        if "Final_Rice_30m" in name:
            province_final_candidates.append(path)
            continue

        if FINAL_FILE_PATTERN.search(name):
            final_prefecture_tifs.append(path)

    log(f"All TIFF files found: {len(all_tifs)}")
    log(f"Prefecture final-rice TIFFs: {len(final_prefecture_tifs)}")
    log(f"Province final-rice candidates: {len(province_final_candidates)}")
    log(f"Evidence TIFFs: {len(evidence_tifs)}")

    if final_prefecture_tifs:
        log("Final-rice TIFF examples:")
        for path in final_prefecture_tifs[:10]:
            log(f"  - {path.name}")

    if not final_prefecture_tifs and not province_final_candidates:
        available = "\n".join(f"  - {p.name}" for p in all_tifs[:50])
        raise FileNotFoundError(
            "No final-rice TIFF files matching the expected names were found.\n"
            "Expected names similar to:\n"
            "HLJ_Rice_2025_Harbin_30m.tif\n\n"
            f"TIFF files found:\n{available}"
        )

    return final_prefecture_tifs, province_final_candidates, evidence_tifs


# ============================================================
# 4. MOSAIC CREATION
# ============================================================

def create_final_mosaic(final_prefecture_tifs, province_final_candidates):
    mosaic_final = str(GDB_PATH / "HLJ_Rice_2025_Final_Mosaic")

    if arcpy.Exists(mosaic_final):
        arcpy.management.Delete(mosaic_final)

    if province_final_candidates:
        source = province_final_candidates[0]

        arcpy.management.CopyRaster(
            in_raster=str(source),
            out_rasterdataset=mosaic_final,
            pixel_type="8_BIT_UNSIGNED",
            nodata_value="0"
        )

        log(f"Copied existing province raster: {source.name}")

    else:
        first = arcpy.Raster(str(final_prefecture_tifs[0]))

        arcpy.management.MosaicToNewRaster(
            input_rasters=";".join(
                str(path) for path in final_prefecture_tifs
            ),
            output_location=str(GDB_PATH),
            raster_dataset_name_with_extension=(
                "HLJ_Rice_2025_Final_Mosaic"
            ),
            coordinate_system_for_the_raster=(
                first.spatialReference
            ),
            pixel_type="8_BIT_UNSIGNED",
            cellsize=first.meanCellWidth,
            number_of_bands=1,
            mosaic_method="MAXIMUM",
            mosaic_colormap_mode="FIRST"
        )

        log(
            f"Mosaic created from "
            f"{len(final_prefecture_tifs)} prefecture rasters."
        )

    final_tif = OUT_DIR / "HLJ_Rice_2025_Final_Mosaic_30m.tif"

    arcpy.management.CopyRaster(
        in_raster=mosaic_final,
        out_rasterdataset=str(final_tif),
        pixel_type="8_BIT_UNSIGNED",
        nodata_value="0",
        format="TIFF"
    )

    log(f"Final mosaic GeoTIFF saved: {final_tif}")
    return final_tif


# ============================================================
# 5. AREA CALCULATION
# ============================================================

def prefecture_name_from_file(path):
    name = path.stem
    name = re.sub(
        r"^HLJ_Rice_2025_",
        "",
        name,
        flags=re.IGNORECASE
    )
    name = re.sub(
        r"_30m$",
        "",
        name,
        flags=re.IGNORECASE
    )
    return name.replace("_", " ").strip()


def raster_binary_area_ha(raster_path):
    raster = arcpy.Raster(str(raster_path))
    spatial_reference = raster.spatialReference

    arr = arcpy.RasterToNumPyArray(
        raster,
        nodata_to_value=0
    )

    if arr.ndim == 3:
        arr = arr[0]

    positive_pixels = int(np.count_nonzero(arr > 0))

    if spatial_reference.type == "Projected":
        cell_area_m2 = abs(
            raster.meanCellWidth *
            raster.meanCellHeight
        )

        area_ha = (
            positive_pixels *
            cell_area_m2 /
            10000.0
        )

        method = "projected_pixel_area"

    else:
        rows, cols = arr.shape
        extent = raster.extent

        pixel_width_deg = abs(
            (extent.XMax - extent.XMin) / cols
        )
        pixel_height_deg = abs(
            (extent.YMax - extent.YMin) / rows
        )

        km_per_deg_lat = 111.32
        area_ha = 0.0

        for row in range(rows):
            latitude = (
                extent.YMax -
                (row + 0.5) * pixel_height_deg
            )

            km_per_deg_lon = (
                111.32 *
                math.cos(math.radians(latitude))
            )

            pixel_area_ha = (
                pixel_width_deg *
                km_per_deg_lon *
                pixel_height_deg *
                km_per_deg_lat *
                100
            )

            row_count = int(
                np.count_nonzero(arr[row, :] > 0)
            )

            area_ha += row_count * pixel_area_ha

        method = (
            "latitude_corrected_geographic_pixel_area"
        )

    return area_ha, positive_pixels, method


def create_area_table(final_prefecture_tifs, final_mosaic_tif):
    records = []

    if final_prefecture_tifs:
        for tif in final_prefecture_tifs:
            log(f"Calculating area: {tif.name}")

            area_ha, pixel_count, method = (
                raster_binary_area_ha(tif)
            )

            records.append({
                "prefecture": prefecture_name_from_file(tif),
                "file_name": tif.name,
                "rice_area_ha": area_ha,
                "rice_area_km2": area_ha / 100.0,
                "rice_pixel_count": pixel_count,
                "area_method": method
            })

    else:
        area_ha, pixel_count, method = (
            raster_binary_area_ha(final_mosaic_tif)
        )

        records.append({
            "prefecture": "Heilongjiang total",
            "file_name": final_mosaic_tif.name,
            "rice_area_ha": area_ha,
            "rice_area_km2": area_ha / 100.0,
            "rice_pixel_count": pixel_count,
            "area_method": method
        })

    area_df = pd.DataFrame(records).sort_values(
        "rice_area_ha",
        ascending=False
    ).reset_index(drop=True)

    csv_path = (
        OUT_DIR /
        "HLJ_Rice_2025_Area_by_Prefecture.csv"
    )

    area_df.to_csv(csv_path, index=False)

    log(f"Area table saved: {csv_path}")
    log(
        "Sum of mapped prefecture rice area (ha): "
        f"{area_df['rice_area_ha'].sum():,.2f}"
    )

    return area_df


# ============================================================
# 6. RASTER READING FOR FIGURES
# ============================================================

def raster_to_array_and_extent(path):
    raster = arcpy.Raster(str(path))

    arr = arcpy.RasterToNumPyArray(
        raster,
        nodata_to_value=0
    )

    if arr.ndim == 3:
        arr = arr[0]

    ex = raster.extent
    extent = [
        ex.XMin,
        ex.XMax,
        ex.YMin,
        ex.YMax
    ]

    return arr, extent, raster


# ============================================================
# 7. FINAL PUBLICATION MAP
# ============================================================

def create_final_rice_map(final_mosaic_tif):
    arr, extent, raster = (
        raster_to_array_and_extent(
            final_mosaic_tif
        )
    )

    rice_mask = np.where(
        arr > 0,
        1,
        np.nan
    )

    fig, ax = plt.subplots(
        figsize=(10, 8),
        dpi=300
    )

    ax.imshow(
        rice_mask,
        extent=extent,
        origin="upper",
        cmap="Greens",
        vmin=0,
        vmax=1,
        interpolation="nearest"
    )

    ax.set_title(
        "Spatial Distribution of Rice Fields "
        "in Heilongjiang, 2025",
        fontsize=16,
        fontweight="bold",
        pad=14
    )

    ax.set_xlabel(
        "Longitude / Easting",
        fontsize=12
    )

    ax.set_ylabel(
        "Latitude / Northing",
        fontsize=12
    )

    ax.tick_params(labelsize=10)
    ax.grid(linewidth=0.35, alpha=0.35)

    xmin, xmax, ymin, ymax = extent

    # North arrow
    nx = xmin + 0.92 * (xmax - xmin)
    ny = ymin + 0.82 * (ymax - ymin)

    ax.annotate(
        "N",
        xy=(
            nx,
            ny + 0.09 * (ymax - ymin)
        ),
        xytext=(nx, ny),
        arrowprops=dict(
            arrowstyle="-|>",
            linewidth=1.5
        ),
        ha="center",
        va="center",
        fontsize=13,
        fontweight="bold"
    )

    # Scale bar
    if raster.spatialReference.type == "Geographic":
        latitude_mid = (ymin + ymax) / 2.0

        km_per_degree_lon = (
            111.32 *
            math.cos(math.radians(latitude_mid))
        )

        scale_km = 200
        scale_width = scale_km / km_per_degree_lon

    else:
        scale_km = 200
        scale_width = 200000

    sx = xmin + 0.08 * (xmax - xmin)
    sy = ymin + 0.07 * (ymax - ymin)

    ax.plot(
        [sx, sx + scale_width],
        [sy, sy],
        linewidth=3,
        color="black"
    )

    tick_height = 0.008 * (ymax - ymin)

    ax.plot(
        [sx, sx],
        [sy - tick_height, sy + tick_height],
        color="black"
    )

    ax.plot(
        [sx + scale_width, sx + scale_width],
        [sy - tick_height, sy + tick_height],
        color="black"
    )

    ax.text(
        sx + scale_width / 2.0,
        sy + 0.02 * (ymax - ymin),
        f"{scale_km} km",
        ha="center",
        fontsize=10
    )

    legend_handle = Line2D(
        [0], [0],
        marker="s",
        linestyle="None",
        markerfacecolor=plt.cm.Greens(0.8),
        markeredgecolor="none",
        markersize=12,
        label="Mapped rice"
    )

    ax.legend(
        handles=[legend_handle],
        loc="lower right",
        frameon=True,
        fontsize=10
    )

    plt.tight_layout()

    png_path = (
        OUT_DIR /
        "Figure_1_HLJ_Final_Rice_Map_2025.png"
    )

    pdf_path = (
        OUT_DIR /
        "Figure_1_HLJ_Final_Rice_Map_2025.pdf"
    )

    fig.savefig(
        png_path,
        dpi=600,
        bbox_inches="tight"
    )

    fig.savefig(
        pdf_path,
        bbox_inches="tight"
    )

    plt.close(fig)

    log(f"Final map saved: {png_path}")
    log(f"Final map saved: {pdf_path}")

    return arr, extent, raster


