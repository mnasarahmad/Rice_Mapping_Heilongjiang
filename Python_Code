if __name__ == "__main__":
    try:
        main()

    except Exception as exc:
        error_path = (
            OUT_DIR /
            "ERROR_LOG.txt"
        )

        error_text = (
            f"Error: {exc}\n\n"
            f"{traceback.format_exc()}"
        )

        try:
            error_path.write_text(
                error_text,
                encoding="utf-8"
            )
        except Exception:
