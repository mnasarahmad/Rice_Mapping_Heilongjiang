def write_output_summary():
    summary_path = (
        OUT_DIR /
        "OUTPUT_SUMMARY.txt"
    )

    generated_files = sorted(
        path for path in OUT_DIR.rglob("*")
        if path.is_file()
    )

    content = [
        "HLJ Rice 2025 — Generated Outputs",
        "",
        f"Output directory: {OUT_DIR}",
        "",
        "Files:"
    ]

    content.extend(
        f"- {path.relative_to(OUT_DIR)}"
        for path in generated_files
    )

    summary_path.write_text(
        "\n".join(content),
        encoding="utf-8"
    )

    log(f"Output summary saved: {summary_path}")


